# PostgreSQL — credenciales locales del contenedor de desarrollo.
#
# Copia este archivo a `.env`, pon una contraseña real y `chmod 600 .env`.
# `.env` está ignorado por git (ver 01-TOOLS/.gitignore).
#
# Generar una contraseña fuerte:
#   openssl rand -hex 24

POSTGRES_DB=clinics_db
POSTGRES_USER=clinics_user
# Cambia esto por una contraseña fuerte antes de levantar el contenedor.
POSTGRES_PASSWORD=
# Puerto del host -> 5432 del contenedor. Cambia si el 5432 está ocupado.
POSTGRES_PORT=5432